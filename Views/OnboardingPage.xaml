<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cali.ViewModels"
             x:Class="Cali.Views.OnboardingPage"
             x:Name="Root"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.2" Radius="1.2">
                <GradientStop Color="#1A130C" Offset="0.0" />
                <GradientStop Color="#0D0E11" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid RowDefinitions="*,Auto" Padding="26,64,26,40">
            <VerticalStackLayout Grid.Row="0" Spacing="16" VerticalOptions="Start">
                <!-- Logomark -->
                <Border WidthRequest="54" HeightRequest="54" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Accent}" Stroke="Transparent" HorizontalOptions="Start">
                    <Label Text="C" FontFamily="BarlowCondensedBold" FontSize="30" TextColor="{StaticResource AccentOn}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="{Binding Kicker}" FontFamily="BarlowBold" FontSize="12" CharacterSpacing="3" TextColor="{StaticResource Accent}" Margin="0,18,0,0" />
                <Label Text="{Binding Title}" FontFamily="BarlowCondensedBold" FontSize="42" TextColor="{StaticResource TextPrimary}" LineHeight="1.0" />
                <Label Text="{Binding Body}" FontFamily="Barlow" FontSize="15" LineHeight="1.5" TextColor="{StaticResource TextMuted}" />

                <!-- Option cards -->
                <VerticalStackLayout Spacing="10" Margin="0,12,0,0" IsVisible="{Binding ShowOptions}"
                                     BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionVM">
                            <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" StrokeThickness="1" Padding="16,14">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Label}" FontFamily="BarlowSemiBold" FontSize="16" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding Hint}" FontFamily="Barlow" FontSize="13" TextColor="{StaticResource TextFaint}" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectOptionCommand}" CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Bottom: dots + CTA + skip -->
            <VerticalStackLayout Grid.Row="1" Spacing="16">
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border WidthRequest="{Binding Dot0W}" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="{Binding Dot0}" Stroke="Transparent" />
                    <Border WidthRequest="{Binding Dot1W}" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="{Binding Dot1}" Stroke="Transparent" />
                    <Border WidthRequest="{Binding Dot2W}" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="{Binding Dot2}" Stroke="Transparent" />
                    <Border WidthRequest="{Binding Dot3W}" HeightRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="{Binding Dot3}" Stroke="Transparent" />
                </HorizontalStackLayout>

                <Button Text="{Binding CtaText}" Command="{Binding AdvanceCommand}" IsVisible="{Binding ShowCta}"
                        BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource AccentOn}"
                        FontFamily="BarlowBold" FontSize="16" HeightRequest="58" CornerRadius="16" />
                <Button Text="Skip" Command="{Binding SkipCommand}" BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                        FontFamily="BarlowSemiBold" FontSize="14" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
