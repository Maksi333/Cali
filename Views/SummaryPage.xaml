<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cali.Views.SummaryPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="Stroke" Value="{StaticResource Line}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16,18" />
        </Style>
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="FontFamily" Value="BarlowCondensedBold" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="StatLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="BarlowSemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextColor" Value="{StaticResource TextFaint}" />
        </Style>
        <Style x:Key="EffortBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="BarlowSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="HeightRequest" Value="46" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.25" Radius="1.1">
                <GradientStop Color="#1A130C" Offset="0.0" />
                <GradientStop Color="#0D0E11" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="22,60,22,40" Spacing="18" HorizontalOptions="Fill">

                <!-- Animated check -->
                <Grid x:Name="CheckRoot" WidthRequest="118" HeightRequest="118" HorizontalOptions="Center">
                    <Ellipse x:Name="PulseRing" Stroke="{StaticResource Accent}" StrokeThickness="2"
                             WidthRequest="118" HeightRequest="118" />
                    <Border WidthRequest="92" HeightRequest="92" StrokeShape="RoundRectangle 46"
                            BackgroundColor="{StaticResource Accent}" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="&#x2713;" FontSize="48" FontFamily="BarlowBold"
                               TextColor="{StaticResource AccentOn}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Label Text="WORKOUT COMPLETE" HorizontalOptions="Center" FontFamily="BarlowBold"
                       FontSize="12" CharacterSpacing="3" TextColor="{StaticResource Accent}" />
                <Label Text="Nailed it. &#x1F4AA;" HorizontalOptions="Center" FontFamily="BarlowCondensedBold"
                       FontSize="38" TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding PlanLine}" HorizontalOptions="Center" FontFamily="Barlow"
                       FontSize="14" TextColor="{StaticResource TextMuted}" Margin="0,-8,0,0" />

                <!-- 2x2 stat grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" Margin="0,6,0,0">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DurationText}" Style="{StaticResource StatValue}" />
                            <Label Text="DURATION" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ExerciseCount}" Style="{StaticResource StatValue}" />
                            <Label Text="EXERCISES" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalSets}" Style="{StaticResource StatValue}" />
                            <Label Text="TOTAL SETS" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalReps}" Style="{StaticResource StatValue}" />
                            <Label Text="TOTAL REPS" Style="{StaticResource StatLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- PR banner -->
                <Border IsVisible="{Binding HasPr}" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                        Background="{StaticResource AccentGradient}" Padding="16,14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="&#x1F3C6;  NEW PERSONAL RECORD" FontFamily="BarlowBold" FontSize="12"
                               CharacterSpacing="1" TextColor="{StaticResource AccentOn}" />
                        <Label Text="{Binding PrText}" FontFamily="BarlowSemiBold" FontSize="15"
                               TextColor="{StaticResource AccentOn}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Effort -->
                <Label Text="HOW DID IT FEEL?" FontFamily="BarlowBold" FontSize="11" CharacterSpacing="2"
                       TextColor="{StaticResource TextFaint}" Margin="2,6,0,0" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Too easy" Style="{StaticResource EffortBtn}"
                            BackgroundColor="{Binding EasyBg}" TextColor="{Binding EasyText}"
                            Command="{Binding SetEffortCommand}" CommandParameter="0" />
                    <Button Grid.Column="1" Text="Just right" Style="{StaticResource EffortBtn}"
                            BackgroundColor="{Binding JustBg}" TextColor="{Binding JustText}"
                            Command="{Binding SetEffortCommand}" CommandParameter="1" />
                    <Button Grid.Column="2" Text="Too hard" Style="{StaticResource EffortBtn}"
                            BackgroundColor="{Binding HardBg}" TextColor="{Binding HardText}"
                            Command="{Binding SetEffortCommand}" CommandParameter="2" />
                </Grid>

                <Button Text="SAVE TO HISTORY" Command="{Binding SaveToHistoryCommand}"
                        BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource AccentOn}"
                        FontFamily="BarlowBold" FontSize="16" HeightRequest="58" CornerRadius="16" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Achievement unlock toast (animated sequentially in code-behind) -->
        <Border x:Name="ToastHost" IsVisible="False" Opacity="0" VerticalOptions="Start" HorizontalOptions="Center"
                Margin="22,70,22,0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Line}" StrokeThickness="1.5" Padding="16,12">
            <HorizontalStackLayout Spacing="12">
                <Label x:Name="ToastEmoji" FontSize="26" VerticalOptions="Center" />
                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                    <Label Text="ACHIEVEMENT UNLOCKED" FontFamily="BarlowBold" FontSize="10" CharacterSpacing="1.5"
                           TextColor="{StaticResource TextFaint}" />
                    <Label x:Name="ToastName" FontFamily="BarlowSemiBold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
