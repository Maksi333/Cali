<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Cali.Core.Models;assembly=Cali.Core"
             x:Class="Cali.Views.ExercisePickerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">
    <Grid RowDefinitions="Auto,*" Padding="0,16,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="22,4,22,12">
            <Label Text="Add exercise" FontFamily="BarlowCondensedBold" FontSize="26"
                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Close" Clicked="OnClose"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource TextPrimary}"
                    FontFamily="BarlowSemiBold" FontSize="13" CornerRadius="10" HeightRequest="36" Padding="14,0" />
        </Grid>
        <CollectionView Grid.Row="1" x:Name="List" ItemsSource="{Binding Exercises}"
                        SelectionMode="Single" SelectionChanged="OnSelect" Margin="22,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:Exercise">
                    <Grid Padding="0,12" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" FontSize="16"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding Primary}" FontFamily="Barlow" FontSize="12"
                                   TextColor="{StaticResource TextFaint}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Difficulty}" FontFamily="BarlowSemiBold"
                               FontSize="12" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
