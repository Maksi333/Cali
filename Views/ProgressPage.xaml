<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cali.ViewModels"
             xmlns:c="clr-namespace:Cali.Controls"
             x:Class="Cali.Views.ProgressPage"
             Title="Progress"
             BackgroundColor="{StaticResource Bg}">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="Stroke" Value="{StaticResource Line}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16,16" />
        </Style>
        <Style x:Key="CardLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="BarlowSemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{StaticResource TextFaint}" />
        </Style>
        <Style x:Key="CardValue" TargetType="Label">
            <Setter Property="FontFamily" Value="BarlowCondensedBold" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
    <ScrollView IsVisible="{Binding HasData}">
        <VerticalStackLayout Padding="22,20,22,30" Spacing="16">
            <Label Text="Progress" FontFamily="BarlowCondensedBold" FontSize="32" TextColor="{StaticResource TextPrimary}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="This week" Style="{StaticResource CardLabel}" />
                        <Label Text="{Binding WeekSessions, StringFormat='{0} sessions'}" Style="{StaticResource CardValue}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Total volume" Style="{StaticResource CardLabel}" />
                        <Label Text="{Binding TotalVolume, StringFormat='{0} reps'}" Style="{StaticResource CardValue}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Time trained" Style="{StaticResource CardLabel}" />
                        <Label Text="{Binding TimeTrained, StringFormat='{0} hrs'}" Style="{StaticResource CardValue}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Longest streak" Style="{StaticResource CardLabel}" />
                        <Label Text="{Binding LongestStreak, StringFormat='{0} days'}" Style="{StaticResource CardValue}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Weekly volume -->
            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Weekly volume" FontFamily="BarlowCondensedBold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Column="1" Text="{Binding TrendText}" FontFamily="BarlowSemiBold" FontSize="12"
                               TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                    </Grid>
                    <c:VolumeBarChart HeightRequest="150" Values="{Binding WeekValues}" Labels="{Binding DayLabels}" Highlight="{Binding HighlightDay}" />
                </VerticalStackLayout>
            </Border>

            <!-- Achievements -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Label Text="Achievements" FontFamily="BarlowCondensedBold" FontSize="18"
                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{Binding SeeAllText}" Command="{Binding OpenAchievementsCommand}"
                        BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Accent}"
                        FontFamily="BarlowBold" FontSize="13" CornerRadius="10" HeightRequest="34" Padding="12,0"
                        BorderColor="{StaticResource Line}" BorderWidth="1" />
            </Grid>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Achievements}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementVM">
                            <Border WidthRequest="92" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Line}" StrokeThickness="1" Padding="10,14" Opacity="{Binding ItemOpacity}">
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="{Binding Icon}" FontSize="26" HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" FontSize="11" LineBreakMode="WordWrap"
                                           HorizontalTextAlignment="Center" TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Recent workouts -->
            <Label Text="RECENT WORKOUTS" FontFamily="BarlowBold" FontSize="11" CharacterSpacing="2" TextColor="{StaticResource Accent}" />
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Recent}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentVM">
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" StrokeThickness="1" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 9" BackgroundColor="{StaticResource Surface2}" Stroke="Transparent" Padding="10,6" VerticalOptions="Center">
                                    <Label Text="{Binding DateChip}" FontFamily="BarlowSemiBold" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontFamily="BarlowSemiBold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding Meta}" FontFamily="Barlow" FontSize="12" TextColor="{StaticResource TextFaint}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding EffortText}" TextColor="{Binding EffortColor}"
                                       FontFamily="BarlowSemiBold" FontSize="12" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <!-- Empty state (BUG-009): shown until the first workout is completed -->
    <VerticalStackLayout IsVisible="{Binding IsEmpty}" VerticalOptions="Center" HorizontalOptions="Center"
                         Spacing="14" Padding="40,0">
        <Border WidthRequest="76" HeightRequest="76" StrokeShape="RoundRectangle 22"
                BackgroundColor="{StaticResource AccentTint}" Stroke="Transparent" HorizontalOptions="Center">
            <Label Text="&#x1F4C8;" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
        <Label Text="No progress yet" FontFamily="BarlowCondensedBold" FontSize="24"
               TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
        <Label Text="Finish your first workout and your stats, streak and weekly volume will show up here."
               FontFamily="Barlow" FontSize="14" LineHeight="1.4" TextColor="{StaticResource TextMuted}"
               HorizontalTextAlignment="Center" />
        <Button Text="Start a workout" Command="{Binding StartFirstCommand}"
                BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource AccentOn}"
                FontFamily="BarlowBold" FontSize="15" CornerRadius="14" HeightRequest="52"
                Padding="28,0" HorizontalOptions="Center" Margin="0,6,0,0" />
    </VerticalStackLayout>
    </Grid>
</ContentPage>
